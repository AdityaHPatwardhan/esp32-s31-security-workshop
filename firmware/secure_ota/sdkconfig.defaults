# ESP32-S31 security workshop: Secure Boot V2 + flash encryption + HMAC NVS encryption + signed HTTPS OTA
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# Wi-Fi: open network EspressifEvent
CONFIG_EXAMPLE_CONNECT_WIFI=y
CONFIG_EXAMPLE_WIFI_SSID="EspressifEvent"
CONFIG_EXAMPLE_WIFI_PASSWORD=""
CONFIG_EXAMPLE_WIFI_AUTH_OPEN=y

# OTA image hosted on GitHub, verified with the built-in CA bundle
CONFIG_EXAMPLE_FIRMWARE_UPGRADE_URL="https://raw.githubusercontent.com/AdityaHPatwardhan/esp32-s31-security-workshop/main/ota/secure_ota.bin"
CONFIG_EXAMPLE_USE_CERT_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Secure Boot V2 (RSA-3072); bootloader burns the digest on first boot
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot_signing_key.pem"
CONFIG_SECURE_BOOT_FLASH_BOOTLOADER_DEFAULT=y

# Flash encryption, Development mode (bootloader generates the key on first boot)
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT=y

# NVS encryption with an HMAC key in eFuse BLOCK_KEY0 (firmware generates it on first boot)
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=0

# Workaround: RSA accelerator driver asserts in esp_bignum.c on S31 (v6.1) during GitHub TLS handshake
CONFIG_MBEDTLS_HARDWARE_MPI=n
